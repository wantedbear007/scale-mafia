# Copy to .env and adjust. `docker compose` reads .env automatically.

# --- application ----------------------------------------------------------
APP_ENV=development
LOG_LEVEL=info
LOG_FORMAT=json

# --- ports published on the host -----------------------------------------
API_HOST_PORT=8080
POSTGRES_HOST_PORT=5432

# --- database -------------------------------------------------------------
DATABASE_NAME=scaling
DATABASE_USER=scaling
DATABASE_PASSWORD=scaling
DATABASE_SSLMODE=disable

# Connection pool (baseline values - do not tune until Phase 2/3 experiments)
DATABASE_MAX_OPEN_CONNECTIONS=100
DATABASE_MAX_IDLE_CONNECTIONS=50
DATABASE_CONN_MAX_LIFETIME=30m
DATABASE_CONN_MAX_IDLE_TIME=5m
DATABASE_CONNECT_TIMEOUT=10s
DATABASE_WAIT_TIMEOUT=60s

# --- benchmark dataset ----------------------------------------------------
SEED_USERS=100000
SEED_PRODUCTS=50000
SEED_ORDERS=500000
SEED_BATCH_SIZE=5000
SEED_FORCE=false
